# Copiez ce fichier en `.env` puis renseignez vos vraies valeurs.
# `.env` est ignoré par git (voir .gitignore) — ne jamais y mettre de vraies
# clés dans un fichier suivi par git.
#
# Tant que ces deux variables sont vides, le site fonctionne normalement en
# lisant uniquement le contenu statique de src/content/ — voir SUPABASE_SETUP.md.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
